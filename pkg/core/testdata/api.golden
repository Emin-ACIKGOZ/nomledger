pkg/errors var ( ErrZeroSumViolation = errors.New("transaction does not sum to zero") ErrPeriodClosed = errors.New("effective date falls in closed period") ErrRateDeviation = errors.New("exchange rate exceeds tolerance") ErrRateProvider = errors.New("rate provider error") ErrInvalidPrecision = errors.New("amount exceeds currency precision") ErrCurrencyMismatch = errors.New("entry functional currency does not match ledger") ErrEmptyTransaction = errors.New("transaction must contain at least one entry") ErrZeroAmount = errors.New("transaction amount must be non-zero") ErrFunctionalAmountZero = errors.New("functional amount rounds to zero") ErrInvalidEntry = errors.New("invalid entry") ErrNilRateProvider = errors.New("rate provider must not be nil") ErrInvalidTransactionID = errors.New("invalid transaction ID") ErrInvalidEffectiveDate = errors.New("invalid effective date") ErrInvalidMetadata = errors.New("invalid metadata") ErrInvalidAccountID = errors.New("invalid account ID") ErrInvalidAccountType = errors.New("invalid account type") ErrInvalidMeasurementCategory = errors.New("invalid measurement category") ErrInvalidExchangeRate = errors.New("exchange rate must be strictly positive") ErrInvalidConfiguration = errors.New("invalid ledger configuration") ErrUnknownCurrency = errors.New("unknown or unsupported currency code") ErrInvalidCurrencyCode = errors.New("currency code must be exactly three ASCII letters") ErrCurrencyNotRatable = errors.New("currency has no defined minor units") ErrInvalidRoundingMode = errors.New("invalid rounding mode") ErrInexactRounding = errors.New("rounding would change the value") ErrBuilderFinalized = errors.New("builder is already finalized"))
